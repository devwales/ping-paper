<Window x:Class="Ping.UI.UpcomingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" Width="304" SizeToContent="Height"
        WindowStartupLocation="Manual">
    <Border Background="{StaticResource PaperBrush}" CornerRadius="16"
            Effect="{StaticResource SoftShadow}" Padding="16" Margin="6">
        <StackPanel>
            <TextBlock Text="Upcoming" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}"/>
            <TextBlock Text="Just the next few." FontSize="11"
                       Foreground="{StaticResource MutedBrush}" Margin="0,2,0,10"/>

            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Top" Margin="0,2,8,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Path="FriendlyDay"/>
                                        <Binding Path="FriendlyTime"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13"
                                       Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="EmptyNote" Text="Nothing scheduled. Enjoy the quiet."
                       FontSize="12" Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" Margin="0,8" Visibility="Collapsed"/>

            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,10"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusNote" FontSize="11" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                <Button x:Name="PrintAllButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                        Content="Print all for today" FontSize="11" Padding="8,4"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
