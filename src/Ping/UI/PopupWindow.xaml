<Window x:Class="Ping.UI.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" Width="232" SizeToContent="Height"
        WindowStartupLocation="Manual">
    <Border Background="{StaticResource PaperBrush}" CornerRadius="16"
            Effect="{StaticResource SoftShadow}" Padding="14" Margin="6">
        <StackPanel>
            <Button x:Name="AddButton" Style="{StaticResource CalmButton}" Content="+  Add task"/>
            <Button x:Name="UpcomingButton" Style="{StaticResource GhostButton}" Content="Upcoming"
                    Margin="0,6,0,0"/>
            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="2,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="SettingsButton" Style="{StaticResource GhostButton}" Content="Settings"
                        FontSize="11" Padding="8,4"/>
                <Button x:Name="PrintTodayButton" Style="{StaticResource GhostButton}" Content="Print today"
                        FontSize="11" Padding="8,4" ToolTip="Print everything left for today"/>
                <Button x:Name="HideButton" Style="{StaticResource GhostButton}" Content="Hide"
                        FontSize="11" Padding="8,4" ToolTip="Hide the bubble (Ping keeps running in the tray)"/>
                <Button x:Name="QuitButton" Style="{StaticResource GhostButton}" Content="Quit"
                        FontSize="11" Padding="8,4"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
