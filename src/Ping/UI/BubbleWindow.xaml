<Window x:Class="Ping.UI.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Grid x:Name="Root" Width="72" Height="72">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="Scaler" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Ellipse Width="56" Height="56" Margin="8">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.35,0.3" RadiusX="0.8" RadiusY="0.8">
                    <GradientStop Color="#F4FAF8" Offset="0"/>
                    <GradientStop Color="#C9E6DF" Offset="0.65"/>
                    <GradientStop Color="#A6D4CA" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.28" Color="#4A6A63"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="16" Height="9" IsHitTestVisible="False" Opacity="0.55"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,16,0,0"
                 RenderTransformOrigin="0.5,0.5" Fill="White">
            <Ellipse.RenderTransform>
                <RotateTransform Angle="-25"/>
            </Ellipse.RenderTransform>
        </Ellipse>
    </Grid>
</Window>
